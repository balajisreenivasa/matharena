# Database (SQLite file). Prisma resolves this relative to prisma/, so it lands at prisma/matharena.db.
DATABASE_URL="file:./matharena.db"

# Only needed if you fall back to AI topic tagging (npm run classify -- --ai).
# The default heuristic tagger runs offline and needs no key.
# The app itself does NOT need this to run day to day.
ANTHROPIC_API_KEY=""
