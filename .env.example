# Database (SQLite file). Prisma resolves this relative to prisma/, so it lands at prisma/matharena.db.
DATABASE_URL="file:./matharena.db"

# Only needed if you fall back to AI topic tagging (npm run classify -- --ai).
# The default heuristic tagger runs offline and needs no key.
# The app itself does NOT need this to run day to day.
ANTHROPIC_API_KEY=""

# Daily delivery (npm run daily). Leave blank to save mails to data/outbox/ instead of sending.
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=you@gmail.com SMTP_PASS=<16-char app password>
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# Where links in the emails point (the running dev server).
APP_URL="http://localhost:3000"
