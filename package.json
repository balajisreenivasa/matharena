{
  "name": "matharena",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "verify": "tsx scripts/verify.ts && tsx scripts/check-lessons.ts && tsx scripts/check-lesson-plans.ts",
    "test": "playwright test",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "tsx scripts/seed.ts",
    "scrape": "tsx scripts/scrape.ts",
    "import": "tsx scripts/import.ts",
    "classify": "tsx scripts/classify.ts",
    "build:data": "tsx scripts/import.ts && tsx scripts/classify.ts && tsx scripts/seed.ts",
    "db:push": "prisma db push",
    "tag": "tsx scripts/tag.ts",
    "daily": "tsx scripts/daily.ts",
    "schema:pg": "tsx scripts/make-postgres-schema.ts",
    "vercel-build": "prisma generate --schema=prisma/schema.postgres.prisma && prisma db push --schema=prisma/schema.postgres.prisma --skip-generate --accept-data-loss && next build",
    "db:export": "tsx scripts/export-db.ts",
    "db:import": "tsx scripts/import-db.ts",
    "postinstall": "prisma generate",
    "db:backup": "tsx scripts/backup-hosted.ts"
  },
  "prisma": {
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "katex": "^0.16.11",
    "next": "^14.2.35",
    "nodemailer": "^10.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "cheerio": "^1.0.0",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
